{
  "name": "fluxcut",
  "displayName": "Fluxcut",
  "description": "Makes a product video from a goal. Installs Fluxcut's MCP server, the maker skill, and the long-wait timeout. Your agent drives the gates; you approve them and you publish.",
  "version": "1.43.1",
  "author": {
    "name": "Fluxcut",
    "url": "https://www.fluxcut.dev"
  },
  "homepage": "https://www.fluxcut.dev/connect",
  "icon": "./assets/icon.png",
  "documentationUrl": "https://www.fluxcut.dev/connect",
  "privacyPolicyUrl": "https://www.fluxcut.dev/privacy",
  "termsOfServiceUrl": "https://www.fluxcut.dev/terms",
  "repository": "https://github.com/Flux-AI-Agent/fluxcut-plugin",
  "license": "MIT",
  "keywords": [
    "fluxcut",
    "video",
    "product-demo",
    "promo",
    "mcp"
  ],
  "userConfig": {
    "fluxcut_key": {
      "type": "string",
      "title": "Fluxcut key",
      "description": "Your maker key from https://www.fluxcut.dev/settings/keys (fcx_…). Kept in your system's secure storage.",
      "required": true,
      "sensitive": true
    }
  },
  "skills": "./skills/",
  "mcpServers": {
    "fluxcut": {
      "type": "http",
      "url": "https://www.fluxcut.dev/mcp?wait=240",
      "timeout": 300000,
      "headers": {
        "Authorization": "Bearer ${user_config.fluxcut_key}"
      }
    }
  }
}
