{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Flux-AI-Agent/fluxcut",
  "title": "Fluxcut",
  "description": "Your agent makes a product video; you approve each step and publish. Needs a Fluxcut agent key.",
  "version": "1.41.0",
  "websiteUrl": "https://www.fluxcut.dev",
  "repository": {
    "url": "https://github.com/Flux-AI-Agent/fluxcut-plugin",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.fluxcut.dev/mcp?wait=240",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer and your Fluxcut agent key (fcx_…), made at https://www.fluxcut.dev/settings/keys",
          "value": "Bearer {fluxcut_key}",
          "isRequired": true,
          "isSecret": true,
          "variables": {
            "fluxcut_key": {
              "description": "Your Fluxcut agent key",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
